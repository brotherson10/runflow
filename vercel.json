{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/((?![aA][pP][iI](?:/|$)).*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Strict-Transport-Security": "max-age=31536000",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/[aA][pP][iI](?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/((?![aA][pP][iI](?:/|$))[^.]*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/purge-rate-limits",
      "schedule": "17 3 * * *"
    }
  ]
}
