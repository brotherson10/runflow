# Copie para .env e ajuste se necessário.
# Os valores de base de dados abaixo são credenciais LOCAIS de desenvolvimento,
# usadas só pelo container Docker do RunFlow. Nunca use estes valores em produção.

# Porta da API (apps/api). A 3100 evita colisões com servidores que usam a 3000.
PORT=3100

# Desenvolvimento web (apps/web): destino do proxy do Vite para /api.
API_PROXY_TARGET=http://localhost:3100

# --- PostgreSQL local (compose.yaml) ---
# Se mudar a porta ou a palavra-passe, atualize também os URLs abaixo.
RUNFLOW_DB_PORT=55432
RUNFLOW_DB_USER=runflow
RUNFLOW_DB_PASSWORD=runflow_local_dev
RUNFLOW_DB_NAME=runflow_dev

# Só no servidor (API, migrations). Nunca usar prefixo VITE_ nem expor à web.
DATABASE_URL=postgres://runflow:runflow_local_dev@127.0.0.1:55432/runflow_dev

# Base de TESTES, separada da de desenvolvimento. O nome tem de terminar em
# "_test" e o host tem de ser local; caso contrário os testes recusam-se a limpar.
TEST_DATABASE_URL=postgres://runflow:runflow_local_dev@127.0.0.1:55432/runflow_test

# --- Autenticação (Better Auth) — só no servidor ---
# NODE_ENV: development (padrão) | test | production. Em produção, a API recusa
# arrancar sem BETTER_AUTH_SECRET e APP_URL em https (na Vercel também CRON_SECRET
# e TRUST_PROXY).
# Fica comentado porque o Vite também lê este ficheiro.
# NODE_ENV=development

# Segredo de assinatura/cifra (mínimo 32 caracteres). NÃO coloque aqui um valor real
# partilhado. Gere um localmente, por exemplo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Vazio em desenvolvimento: a API gera um segredo temporário (sessões perdem-se ao reiniciar).
BETTER_AUTH_SECRET=

# Origem pública da aplicação (sem caminho). É a única origem confiável para o
# Better Auth e a base dos links de recuperação. Em desenvolvimento é a do Vite.
APP_URL=http://localhost:5173

# Proxies confiáveis para obter o IP do cliente (rate limiting). Vazio/false: usa o
# endereço da ligação e ignora X-Forwarded-For. Indique o nº de proxies (ex.: 1) ou
# os seus IPs/CIDRs. "true" (confiar em todos) é recusado.
TRUST_PROXY=false

# Rate limiting das rotas de domínio (/api/v1/workouts), por IP do cliente.
API_RATE_LIMIT_WINDOW_S=60
API_RATE_LIMIT_READ_MAX=120
API_RATE_LIMIT_WRITE_MAX=30

# Limpeza dos registos expirados de rate limiting dentro da API (segundos entre
# execuções, 60–86400). 0 desliga (ex.: se correr por cron: npm run db:purge-rate-limits).
RATE_LIMIT_PURGE_INTERVAL_S=3600

# Sem e-mail: projeto demonstrativo sem confirmação de e-mail nem recuperação de
# palavra-passe (D52).

# Palavras-passe comprometidas (Have I Been Pwned, k-anonymity: só 5 caracteres do
# SHA-1 saem do servidor) no registo, redefinição e troca. "off" só fora de produção
# (ex.: trabalhar sem Internet); os testes usam um HIBP simulado.
PASSWORD_BREACH_CHECK=hibp

# Build da web servido pelo Express na mesma origem (caminho ABSOLUTO). Vazio em
# desenvolvimento (a web corre no Vite); em produção, por omissão, apps/web/dist.
# WEB_DIST_DIR=
